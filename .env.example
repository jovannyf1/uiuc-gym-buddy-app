# Optional: enables AI interpretation of uploaded schedule screenshots.
# Keep this key on the server. Never put it in the client or commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional hosted database. Leave blank for local SQLite development.
# In Vercel, use Supabase Connect -> Transaction pooler (port 6543).
# Keep this password-bearing URI server-side only.
SUPABASE_DATABASE_URL=

# Email/password sign-in with optional in-app verification for account recovery.
# Set EMAIL_FROM, PUBLIC_APP_URL,
# and SMTP_HOST/SMTP_USER/SMTP_PASSWORD or RESEND_API_KEY. SMTP is preferred
# when both are configured. Port 465 uses TLS; other ports use STARTTLS.
# PUBLIC_APP_URL is the HTTPS site students open; verification/reset links point there.
# Gmail example settings require a Google App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_APP_URL=

# Set true when the app is served over HTTPS behind a trusted proxy.
COOKIE_SECURE=false

# The API listens on this port. The development web UI listens on 5173.
PORT=8787
