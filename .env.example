# Optional: enables AI interpretation of uploaded schedule screenshots.
# Keep this key on the server. Never put it in the client or commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional hosted database. Leave blank for local SQLite development.
# In Vercel, use Supabase Connect -> Transaction pooler (port 6543).
# Keep this password-bearing URI server-side only.
SUPABASE_DATABASE_URL=

# Illinois NetID single sign-on needs a registered University OIDC application.
# Set all four values together after campus identity staff approve/register it.
# The redirect URI must end in /api/auth/netid/callback and match registration.
ILLINOIS_OIDC_ISSUER=
ILLINOIS_OIDC_CLIENT_ID=
ILLINOIS_OIDC_CLIENT_SECRET=
ILLINOIS_OIDC_REDIRECT_URI=

# Optional verified email/password sign-in. Set EMAIL_FROM, PUBLIC_APP_URL,
# and SMTP_HOST/SMTP_USER/SMTP_PASSWORD or RESEND_API_KEY. SMTP is preferred
# when both are configured. Port 465 uses TLS; other ports use STARTTLS.
# PUBLIC_APP_URL is the HTTPS site students open; verification/reset links point there.
# Gmail example settings require a Google App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_APP_URL=

# Set true when the app is served over HTTPS behind a trusted proxy.
COOKIE_SECURE=false

# Unverified local pilot accounts are for development and a closed class pilot
# only. The verified email sign-in above uses separate endpoints and identities.
# Pilot auth stays off when either verified email or NetID is configured.
ALLOW_PILOT_AUTH=false

# The API listens on this port. The development web UI listens on 5173.
PORT=8787
